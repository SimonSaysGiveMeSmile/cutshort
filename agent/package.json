{
  "name": "cutshort-agent",
  "version": "0.1.0",
  "private": false,
  "license": "GPL-3.0",
  "description": "CutShort desktop agent — receives shortcut combos from the phone over WebSocket (LAN or Cloudflare tunnel) and injects them as real OS keystrokes on macOS/Windows/Linux.",
  "type": "module",
  "bin": {
    "cutshort-agent": "src/index.js"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "bundle": "node scripts/bundle-app.mjs",
    "prepublishOnly": "node scripts/bundle-app.mjs"
  },
  "keywords": [
    "shortcut",
    "keyboard",
    "remote",
    "macros",
    "stream-deck",
    "nut-js",
    "websocket",
    "cloudflare-tunnel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SimonSaysGiveMeSmile/cutshort.git",
    "directory": "agent"
  },
  "homepage": "https://github.com/SimonSaysGiveMeSmile/cutshort#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
